generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NUXT_DATABASE_URL")
}

model Recipe {
  id          Int         @id @default(autoincrement())
  user_id     String
  title       String      @db.VarChar(300)
  content     String      @default("") @db.Text
  // Per-user "favorite" flag used to pin standout recipes on the
  // home grid + drive the favorites-only filter. Stored on the
  // recipe row itself because the workspace is shared — anyone's
  // favoring promotes the recipe for everyone.
  is_favorite Boolean     @default(false)
  is_deleted  Boolean     @default(false)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @default(now()) @updatedAt

  tags        RecipeTag[]

  @@index([user_id])
  @@index([user_id, is_deleted])
  @@index([is_favorite])
  @@index([title(ops: raw("gin_trgm_ops"))],   type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("recipes")
}

model Tag {
  id         Int         @id @default(autoincrement())
  user_id    String
  label      String      @db.VarChar(100)
  color      String      @default("cyan")
  position   Int         @default(0)
  created_at DateTime    @default(now())

  recipes    RecipeTag[]

  @@index([user_id])
  @@map("tags")
}

model RecipeTag {
  recipe_id Int
  tag_id    Int

  recipe    Recipe @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  tag       Tag    @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([recipe_id, tag_id])
  @@map("recipe_tags")
}
